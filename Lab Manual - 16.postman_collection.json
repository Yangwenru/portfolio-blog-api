{
  "info": {
    "name": "Lab Manual - 16",
    "description": "Send requests individually. Create records before using their saved IDs. Delete sample records after the read, update, and comment exercises.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAlice",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenBob",
      "value": "",
      "type": "string"
    },
    {
      "key": "userAliceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userBobId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Register Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"CoursePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 creates an author; 409 means the account already exists."
          }
        },
        {
          "name": "Log in as Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"CoursePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('tokenAlice', data.token);",
                  "  pm.collectionVariables.set('userAliceId', data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"email\": \"bob@example.com\",\n  \"password\": \"CoursePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 creates an author; 409 means the account already exists."
          }
        },
        {
          "name": "Log in as Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"CoursePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('tokenBob', data.token);",
                  "  pm.collectionVariables.set('userBobId', data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current account: Alice",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me"
          }
        }
      ]
    },
    {
      "name": "Server",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Blog",
      "item": [
        {
          "name": "Create a post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/blog",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My portfolio blog post\",\n  \"content\": \"A post created while studying web data management.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('postId', data._id || data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read blog posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog"
          }
        },
        {
          "name": "Read a post",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/blog/{{postId}}"
          }
        },
        {
          "name": "Read the posts alias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Update the post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/blog/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated portfolio post\",\n  \"content\": \"Both editable fields are supplied.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Bob cannot edit Alice’s post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": "{{baseUrl}}/api/blog/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My portfolio blog post\",\n  \"content\": \"A post created while studying web data management.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expected status: 403."
          }
        }
      ]
    },
    {
      "name": "Portfolio projects",
      "item": [
        {
          "name": "Create a project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Portfolio and Blog API\",\n  \"description\": \"A cumulative Node.js, Express, and MongoDB project.\",\n  \"imageUrl\": \"\",\n  \"repoUrl\": \"https://github.com/example/portfolio-api\",\n  \"liveUrl\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "From Lab 16, configure Alice as admin first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('projectId', data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "Read a project",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          }
        },
        {
          "name": "Update the project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated portfolio API\",\n  \"description\": \"A cumulative Node.js, Express, and MongoDB project.\",\n  \"imageUrl\": \"\",\n  \"repoUrl\": \"https://github.com/example/portfolio-api\",\n  \"liveUrl\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Bob cannot manage projects",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Portfolio and Blog API\",\n  \"description\": \"A cumulative Node.js, Express, and MongoDB project.\",\n  \"imageUrl\": \"\",\n  \"repoUrl\": \"https://github.com/example/portfolio-api\",\n  \"liveUrl\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expected status: 403."
          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Send a contact message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/contact",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Course Visitor\",\n  \"email\": \"visitor@example.com\",\n  \"message\": \"Please tell me more about your project.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Read contact messages as admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/contact"
          }
        }
      ]
    },
    {
      "name": "Delete sample records",
      "item": [
        {
          "name": "Delete the post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/blog/{{postId}}",
            "description": "Expected status: 204. Delete its comments first."
          }
        },
        {
          "name": "Delete the project",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "description": "Expected status: 204 with no body."
          }
        }
      ]
    }
  ]
}
